# Server-side only. Never referenced from a client component.
# The app is fully functional without this key — every AI call
# has a hardcoded fallback.
OPENAI_API_KEY=sk-...

# true  -> 8s verification, on-screen OTP, /demo controls, prefill
# false -> 120s verification, OTP hidden
NEXT_PUBLIC_DEMO_MODE=true

# Reads every screen in a real neural voice instead of whatever the device
# can manage for itself. Despite the name this is the primary voice path
# now, not a fallback: without it all eleven languages are read by the
# browser's own engine, which on most phones means a Hindi voice sounding
# out respelled Gujarati. Answers are cached per sentence, and it falls
# back to that engine on its own when a provider is out.
NEXT_PUBLIC_ENABLE_TTS_FALLBACK=true

# The landing carousel uses the five photographs in public/stories/.
# Set to false to fall back to the hand-drawn scenes in StoryArt.tsx.
NEXT_PUBLIC_STORY_PHOTOS=true

# The voice helper (Ask out loud). Server-side only, and optional: with no
# key the helper matches what was said against the service catalogue in the
# reader's own language and answers out of the dictionary.
# One key, or several comma-separated, best first. A blocked key (403) is
# struck off and a spent one (429) rests, so the pool survives the very
# small free-tier allowance on the speech models.
GEMINI_API_KEYS=AQ...,AQ...

# Sarvam. First choice for reading aloud and for the voice helper: it is the
# only provider here that speaks all eleven languages, Odia included.
SARVAM_API_KEY=sk_...
