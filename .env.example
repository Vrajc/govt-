# Server-side only. Never referenced from a client component.
# The app is fully functional without this key — every AI call
# has a hardcoded fallback.
OPENAI_API_KEY=sk-...

# true  -> 8s verification, on-screen OTP, /demo controls, prefill
# false -> 120s verification, OTP hidden
NEXT_PUBLIC_DEMO_MODE=true

# Optional: route voice through OpenAI TTS when no local voice exists
# for the chosen language. Costs bandwidth; off by default.
NEXT_PUBLIC_ENABLE_TTS_FALLBACK=false

# The landing carousel uses the five photographs in public/stories/.
# Set to false to fall back to the hand-drawn scenes in StoryArt.tsx.
NEXT_PUBLIC_STORY_PHOTOS=true
